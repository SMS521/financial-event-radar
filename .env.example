# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# FRED_API_KEY: St. Louis Fed / ALFRED API key for archival point-in-time economic releases.
FRED_API_KEY=""

# FINNHUB_API_KEY: Finnhub economic calendar API key for consensus estimates.
FINNHUB_API_KEY=""

# TELEGRAM_BOT_TOKEN: Telegram bot API token from @BotFather
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: Numeric telegram chat ID from @userinfobot
TELEGRAM_CHAT_ID=""

# COUNCIL_API_KEY: Authentication secret for POST /api/agents/council endpoint
COUNCIL_API_KEY=""

# WEBAPP_API_KEY: Shared secret token for FastAPI backend endpoints
WEBAPP_API_KEY=""

# GMAIL_USER: Email address for morning summary deliveries
GMAIL_USER=""

# GMAIL_APP_PASSWORD: 16-character Google App Password
GMAIL_APP_PASSWORD=""
